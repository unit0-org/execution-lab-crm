# .env.test — credentials for a throwaway TEST database. Copy to .env.test
# (gitignored). NEVER point this at the dev or production database: the suite
# TRUNCATES and re-seeds every table on each run.
#
# EASIEST: run the stack locally. `npx supabase start` boots Postgres, GoTrue
# and a mail catcher in Docker and prints every value below. Nothing to pay
# for, and `npx supabase stop` throws it all away.
#
# ALTERNATIVE: a dedicated hosted Supabase project (dashboard -> New project,
# free tier is fine). Connect -> Session pooler for the DB URL, Settings ->
# API for the keys. The values below are then the hosted ones.

# Safety interlock. The suite refuses to touch the database unless this is 1.
E2E_TEST_DB=1

# Postgres — used by Sequelize AND by the harness to seed/truncate. TLS is
# decided from the host: required for a hosted pooler, off for a local stack
# (which doesn't speak it at all). See lib/db/requiresSsl.js.
# Local:  postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=postgresql://postgres.<ref>:<pw>@aws-<n>-<region>.pooler.supabase.com:5432/postgres

# Supabase API — the app's browser + server clients.
# Local:  http://127.0.0.1:54321  (ANON_KEY from `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<test publishable/anon key>

# Service role — needed only by the stories that set a member's password
# (Supabase's auth admin API). Local: SERVICE_ROLE_KEY from `supabase start`.
SUPABASE_SERVICE_ROLE_KEY=<test service role key>

# The app under test runs here (Playwright starts it on this port).
E2E_PORT=3100
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# The organization the portal + seed use. The seed creates an org with this id
# if unset; set it to that id so the app and the seed agree.
PORTAL_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001

# Lets an owner email into the member area with no membership row (the owner
# stories seed exactly this address). Any address works.
PORTAL_OWNER_EMAILS=owner@e2e.test

# Local mail catcher (Mailpit, included in `supabase start`). Lets the suite
# assert that setting a password emails the member NOTHING. Leave unset on a
# hosted project — that one behaviour then skips rather than lying.
E2E_MAIL_URL=http://127.0.0.1:54324

# Bearer secrets for the system endpoints (cron / MCP). Any values are fine on
# a test database; the tests set the matching header.
CRON_SECRET=e2e-cron-secret
MCP_TOKEN=e2e-mcp-token

# Optional — only needed once the paid/checkout and email stories are covered.
# Use Stripe TEST keys and a verified Resend sandbox, or leave unset until then.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
